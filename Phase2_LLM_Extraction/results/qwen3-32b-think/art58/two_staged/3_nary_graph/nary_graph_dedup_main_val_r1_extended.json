    {
      "id": "EV1",
      "node_kind": "Event",
      "type": "ProductRetraction",
      "label": "Google Earth AI tool retracted",
      "is_main": true,
      "evidence": [
        "Google has rolled back its new AI tool that allowed people to create fake images on top of its satellite imagery",
        "Less than 48 hours after the tech giant announced the integration of its AI image generator Nano Banana 2 into Google Earth, it said it was pausing the feature"
      ],
      "confidence": 1.0
    },
    {
      "id": "EV2",
      "node_kind": "Event",
      "type": "MisinformationReport",
      "label": "BBC Verify AI tool misuse test",
      "is_main": true,
      "evidence": [
        "A collapsed Eiffel Tower, a sinkhole swallowing the Great Pyramid of Giza and Russian tanks in Ukraine's capital were among the images BBC Verify was able to create",
        "Tests using external AI detection tools also in some cases failed to identify the Google Earth AI-content"
      ],
      "confidence": 0.95
    },
    {
      "id": "EV3",
      "node_kind": "Event",
      "type": "PublicStatement",
      "label": "Google AI policy statement",
      "is_main": true,
      "evidence": [
        "Google said AI content created by its tools contain invisible watermarks to indicate that they are fake or manipulated",
        "It did, however, allow a community garden to be generated in the same spot"
      ],
      "confidence": 0.98
    },
    {
      "id": "OBS1",
