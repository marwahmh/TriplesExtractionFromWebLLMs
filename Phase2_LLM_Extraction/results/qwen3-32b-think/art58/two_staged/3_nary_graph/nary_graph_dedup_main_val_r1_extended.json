    {
      "id": "CL1",
      "node_kind": "Claim",
      "type": "MisinformationRiskAssessment",
      "label": "Henk van Ess AI risk analysis",
      "is_main": false,
      "evidence": [
        "He said Google had allowed 'invented' imagery to be 'welded to genuine coordinates, drawn on genuine imagery'",
