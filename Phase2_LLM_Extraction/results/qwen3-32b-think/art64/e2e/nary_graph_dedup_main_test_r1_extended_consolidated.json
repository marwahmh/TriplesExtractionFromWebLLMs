      "id": "EV2",
      "node_kind": "Event",
      "type": "VisualArtsEvent",
      "label": "Group of Seven Wembley Exhibition",
      "is_main": true,
      "evidence": [
        "The group's work was selected for the British Empire Exhibition, held at Wembley in 1924, where it received a rapturous response with the British press praising its 'distinct Canadian character.'"
      ],
      "confidence": 0.9,
      "type_oie": "ArtExhibition",
      "type_source": "schema.org",
