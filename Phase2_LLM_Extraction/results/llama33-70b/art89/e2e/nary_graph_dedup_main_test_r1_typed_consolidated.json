    {
      "id": "EV1",
      "node_kind": "Event",
      "type": "MusicCompetition",
      "label": "Eurovision Song Contest 2026",
      "is_main": true,
      "evidence": [
        "Bulgaria won the Eurovision Song Contest on Sunday with Dara's catchy floor-filler \"Bangaranga\" sweeping the 70th edition of the world's biggest live televised music event and pushing into second place Israel, whose participation had triggered a major boycott.",
        "Around 10,000 glammed-up fans filled the Wiener Stadthalle arena in the Austrian capital to watch Saturday's showpiece final of Eurovision, where, as always, the razzmatazz didn't escape the geopolitics in the background.",
        "Bulgaria finished with 516 points, ahead of Israel on 343, Romania on 296, Australia on 287, Italy with 281 and Finland on 279."
      ],
      "confidence": 1,
      "type_oie": "MusicCompetition",
      "type_source": "vocab",
      "type_vocab_id": "T0248",
      "type_is_new_to_vocab": true,
      "type_definition": "A competition where musicians or music groups compete against each other.",
      "type_parent": "Event",
      "type_justification": "No direct match in schema.org for a music competition event."
    },
    {
      "id": "CL1",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "Dara's statement on winning Eurovision",
      "is_main": false,
      "evidence": [
        "\"Everything is possible: Bulgaria just won Eurovision!\" Dara told a press conference."
      ],
      "confidence": 1
    },
    {
      "id": "CL2",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "Atanas Pekanov's statement on Dara's win",
      "is_main": false,
      "evidence": [
        "Bulgarian Deputy Prime Minister Atanas Pekanov on Facebook hailed a \"magnificent story of immense talent, tireless effort, and faith in success, against all criticism\"."
      ],
      "confidence": 1
    },
    {
      "id": "CL3",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "Patrick Bongola's statement on Israel's participation",
      "is_main": false,
      "evidence": [
        "\"Inviting Israel on such a beautiful stage as the Eurovision Song Contest stage is an affront to all the people who believe in humanity, who believe in love and togetherness,\" said Congolese-Austrian artist Patrick Bongola, one of the organisers."
      ],
      "confidence": 1
    }
