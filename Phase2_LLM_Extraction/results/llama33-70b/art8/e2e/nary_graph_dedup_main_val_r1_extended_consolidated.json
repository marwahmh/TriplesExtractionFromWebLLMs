      "label": "US-Iran War",
      "is_main": true,
      "evidence": [
        "Since the United States and Israel launched a war on Iran in late February, the global energy sector has undergone major upheaval."
      ],
      "confidence": 1,
      "type_oie": "War",
      "type_source": "vocab",
      "type_vocab_id": "T0019",
      "type_is_new_to_vocab": true,
      "type_definition": "A conflict between two or more states or parties",
      "type_parent": "Event",
