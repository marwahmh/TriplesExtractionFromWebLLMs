    {
      "id": "EV1",
      "node_kind": "Event",
      "type": "Event",
      "label": "English Language Bill passed",
      "is_main": true,
      "evidence": [
        "Lawmakers in New Zealand have passed a bill to make English one of the country’s official languages.",
        "The bill — campaigned for by the nationalist New Zealand First party, part of the coalition government — passed its third reading in the House of Representatives on Thursday.",
        "The English Language Bill states that the addition of English as an official language, alongside Māori and the country’s sign language, will not mean any new rules are needed for it to continue being used in legal, political and government settings or documents."
      ],
      "confidence": 1,
      "type_oie": "LegislativeAction",
      "type_source": "schema.org",
      "type_vocab_id": null,
      "type_is_new_to_vocab": true,
      "type_definition": null,
      "type_parent": null,
      "type_justification": "no exact match in schema.org"
    },
    {
      "id": "CL1",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "English is already widely used",
      "is_main": false,
      "evidence": [
        "The move was widely ridiculed in the Pacific Rim nation, where English is already widely used, including in courts and parliament."
      ],
      "confidence": 1
    },
    {
      "id": "CL2",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "Bill is a waste of time",
      "is_main": false,
      "evidence": [
        "Tamatha Paul, a member of New Zealand’s left-wing Green party, condemned the move as a waste of time, saying the “snowflake” government “see te reo Māori and they shiver in their boots.”"
      ],
      "confidence": 1
    },
    {
      "id": "CL3",
      "node_kind": "Claim",
      "type": "Statement",
      "label": "Bill is important",
      "is_main": false,
      "evidence": [
        "Casey Costello, a member of the New Zealand First party, was among those who defended the move in parliament during the third reading.",
        "“Despite what has been claimed across this House, this bill is important and far from the claimed ‘waste of time,’” Costello added,"
      ],
      "confidence": 1
    }
