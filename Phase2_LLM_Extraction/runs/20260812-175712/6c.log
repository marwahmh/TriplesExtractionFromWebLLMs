g = extract_e2e(ARTICLE_ID)
by_id = {e["id"]: e.get("text") for e in g["entities"]}
by_id.update({n["id"]: n["label"] for n in g["nary_nodes"]})
print("-" * 80)
print(f'{len(g["entities"])} entities  |  {len(g["nary_nodes"])} n-ary nodes  |  {len(g["relations"])} relations')
print("-" * 80)
print("n-ary nodes:")
for n in g["nary_nodes"]:
    star = " *MAIN*" if n.get("is_main") else ""
    print(f'  {n["id"]:<5} {n["node_kind"]:<12} <{n.get("type")}>{star}  "{n["label"]}"')
print("-" * 80)
print("relations (first 30):")
for r in g["relations"][:30]:
    s = by_id.get(r["subject_id"], r["subject_id"]); o = by_id.get(r["object_id"], r["object_id"])
    print(f'  {s!r}  --{r["relation_phrase"]}-->  {o!r}')
