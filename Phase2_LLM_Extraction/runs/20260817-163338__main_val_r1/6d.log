# ---- WHICH EXPERIMENT ---------------------------------------------------------------------
# ONE name decides the whole run. Every knob below comes from configs/<EXPERIMENT>.json — the SAME
# file 6c and 6e read, which is what keeps the three stages of a chain consistent.
#   list what exists :  python -m experiment_config list          (run from notebooks/)
#   see one resolved :  python -m experiment_config show main
# $PHASE2_EXPERIMENT wins when it is set, so a headless batch of ablations (run_e2e.sh) can sweep
# experiments without editing a single notebook.
import os
EXPERIMENT = os.environ.get("PHASE2_EXPERIMENT") or "main"

import sys, pathlib, importlib
for _p in (pathlib.Path.cwd(), *pathlib.Path.cwd().parents):
    if (_p / "experiment_config.py").exists():
        sys.path.insert(0, str(_p)); break
import experiment_config as xcfg; importlib.reload(xcfg)

# Sets the shared keys (RESULTS_MODEL, BACKEND, GEMINI_MODEL, MATCH_MODEL, VARIANT, RUN_TAG,
# SELECTED_ARTICLES) and this section's own:
#   FRESH / EXPAND_MODE / TOP_K_MATCH / ALIGN_QUERY_STYLE
#   INLINE_VOCAB_CANDIDATES            which pool the per-article selection call sees
#   RERANK / RERANK_FROM / RERANK_MODEL              inline cross-encoder stage
#   CONSOLIDATE / CONSOLIDATE_TOP_K / CONSOLIDATE_INCLUDE_SCHEMA / SUBTYPE_MODE
#   RERANK_CONSOLIDATE / RERANK_CONSOLIDATE_FROM     consolidation cross-encoder stage
#   INCLUDE_ALL_SCHEMA                 how much of schema.org the printed hierarchy shows
CFG = xcfg.load(EXPERIMENT, globals(), "6d")
# A one-off try goes RIGHT HERE, below the load, where it wins over the file.

# --- imports + derived paths ---------------------------------------------------------------
import json, re, os, copy, time
from pathlib import Path
from collections import Counter
import numpy as np

SCHEMA_DIR  = ROOT / "schema_org_files"          # schema.org CLASS pool from nb1
RESULTS_DIR = ROOT / "results" / RESULTS_MODEL   # reads e2e/nary_graph<_sfx>.json (6c)

# TWO suffixes, and the difference matters:
#   _sfx   = "_" + VARIANT             identifies the 6c extraction arm — used to READ its graphs.
#   _osfx  = _sfx + "_" + RUN_TAG      everything THIS notebook WRITES, so a new configuration
#                                      never overwrites an older run's outputs.
# 6e reads 6d's output, so 6e's INPUT_TAG must equal this RUN_TAG — which it does automatically,
# because both come from the one config file.
_sfx  = f"_{VARIANT}" if VARIANT else ""
_osfx = _sfx + (f"_{RUN_TAG}" if RUN_TAG else "")

VOCAB_PATH = RESULTS_DIR / f"_global/e2e/type_vocabulary{_osfx}.json"   # SEPARATE per run

# ---- RETRIEVAL / RERANK — what the config's knobs mean here --------------------------------
# INLINE_VOCAB_CANDIDATES = False: the TOP_K_MATCH candidates shown to the selection LLM are ALWAYS
# schema.org — the grown vocabulary is never offered inline. The LLM therefore cannot reuse an
# earlier mint, so it re-mints synonyms of terms it already created; collapsing those is deferred to
# the GLOBAL re-consolidation at the bottom. This is 6k's schema-only design with the fix 6k
# concluded it needed: consolidation at GLOBAL scope, not per-article new-vs-prior.
# NOTE the consequence for metrics: the INLINE mint count goes UP by design. Judge this
# configuration on the POST-CONSOLIDATION vocabulary size, not on the raw mint rate.
#
# RERANK and RERANK_CONSOLIDATE are two INDEPENDENT cross-encoder stages, each with its own depth.
# Each depth is that stage's ceiling — the cross-encoder can only promote what e5 already fetched.
# They differ because the pools differ: the inline stage ranks against ~1.5k schema.org classes,
# while consolidation ranks against the vocabulary itself (order 100 entries), so it reaches the
# same coverage far shallower. Cost is linear in the depth on both sides.
# RERANK_MODEL default is 22M params, English, CPU-friendly. Stronger but much slower on CPU:
# "BAAI/bge-reranker-base" (278M) or "BAAI/bge-reranker-v2-m3" (568M, multilingual).

# Which articles to run on — and the ORDER the vocabulary grows along. Order is part of the run:
# this stage is incremental, so what article k mints depends on what k-1 added.
_available = sorted((p.parent.parent.name for p in RESULTS_DIR.glob(f"*/e2e/nary_graph{_sfx}.json")),
                    key=xcfg.article_key)
if SELECTED_ARTICLES is None:
    ARTICLE_ORDER = _available
else:
    missing = [a for a in SELECTED_ARTICLES if a not in _available]
    if missing:
        print(f"WARNING: skipping (no e2e/nary_graph{_sfx}.json):", missing)
    ARTICLE_ORDER = [a for a in SELECTED_ARTICLES if a in _available]
assert ARTICLE_ORDER, (
    f"No runnable articles. Looked for */e2e/nary_graph{_sfx}.json — 6c's output for VARIANT="
    f"{VARIANT!r}. Run 6c under experiment {EXPERIMENT!r} first.")
print(f"\nreads 6c variant {VARIANT!r} -> nary_graph{_sfx}.json")
print(f"writes run       {RUN_TAG!r} -> *{_osfx}*   |  vocab: {VOCAB_PATH.name}")
print(f"{len(ARTICLE_ORDER)} article(s), in this order: {ARTICLE_ORDER}")
