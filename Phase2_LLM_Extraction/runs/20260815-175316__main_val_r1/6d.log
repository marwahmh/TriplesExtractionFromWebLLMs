# Incremental build — ONE LLM call per article canonicalizes BOTH entity types AND Event-hub types.
# Sequential BY DESIGN: the vocabulary grows article by article and what article k mints depends on
# what k-1 added, so running the articles in parallel would change the output, not just the speed.
#
# FRESH comes from the config. True: start from an EMPTY vocabulary and process ALL of
# ARTICLE_ORDER (what a reported run does — reproducible from the config alone).
# False: keep the existing type_vocabulary<_osfx>.json and extend it with NEW_ARTICLES only
# (or, if that is empty, with every article that has no typed graph yet).
NEW_ARTICLES = []          # used only when FRESH is False

if FRESH:
    vocab = {"types": [], "next_id": 1}; save_vocab(vocab); todo = ARTICLE_ORDER
else:
    vocab = load_vocab()
    todo  = NEW_ARTICLES or [a for a in ARTICLE_ORDER
                             if not (RESULTS_DIR / a / f"e2e/nary_graph{_osfx}_typed.json").exists()]

print(f"building e2e type vocabulary over {len(todo)} article(s): {todo}\n")
nb_parallel.reset_usage()          # the report below covers only the calls THIS run makes
_t0 = time.perf_counter()

for aid in todo:
    with nb_parallel.usage_scope(aid):      # tag this article's calls so the report breaks down per article
        canonicalize_article_types(aid, vocab, write=True, save=True, verbose=True)
    time.sleep(5)                           # gentle on the API's per-minute limit
print(f"\ndone — {len(vocab['types'])} canonical types in {VOCAB_PATH}")

# --- what this run cost: calls, prompt / output / THINKING tokens, and elapsed time ------------
# Written to a tagged file so each experiment keeps its own cost record (run_metrics reads it).
nb_parallel.usage_report(f"6d · e2e type canonicalization · {EXPERIMENT}",
                         wall_seconds=time.perf_counter() - _t0,
                         write=RESULTS_DIR / "_global" / "e2e" / f"token_usage_types{_osfx}.json",
                         experiment=EXPERIMENT, run_tag=RUN_TAG)
