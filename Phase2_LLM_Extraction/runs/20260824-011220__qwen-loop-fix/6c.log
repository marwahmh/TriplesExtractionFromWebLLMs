# ---- WHICH EXPERIMENT ---------------------------------------------------------------------
# ONE name decides the whole run. Every knob below comes from configs/<EXPERIMENT>.json, so a
# finished run is reproducible from a file rather than from whatever the notebook happens to say
# today — and 6c / 6d / 6e cannot drift apart, because all three read the SAME file.
#   list what exists :  python -m experiment_config list          (run from notebooks/)
#   see one resolved :  python -m experiment_config show main
#   sanity-check one :  python -m experiment_config check main
# $PHASE2_EXPERIMENT wins when it is set, so a headless batch of ablations (run_e2e.sh) can sweep
# experiments without editing a single notebook.
import os
EXPERIMENT = os.environ.get("PHASE2_EXPERIMENT") or "main"

import sys, pathlib, importlib
for _p in (pathlib.Path.cwd(), *pathlib.Path.cwd().parents):
    if (_p / "experiment_config.py").exists():
        sys.path.insert(0, str(_p)); break
import experiment_config as xcfg; importlib.reload(xcfg)

# Sets RESULTS_MODEL, BACKEND, GEMINI_MODEL, VARIANT, RUN_TAG, SELECTED_ARTICLES and this
# section's own knobs: PROMPT, REVIEW, WORKERS, THINKING_BUDGET, MAX_OUTPUT_TOKENS.
CFG = xcfg.load(EXPERIMENT, globals(), "6c")
# A one-off try goes RIGHT HERE, below the load, where it wins over the file. Anything you want to
# keep belongs in a config file instead — an override here is lost the moment the name changes.

# --- derived paths -------------------------------------------------------------------------
from pathlib import Path
import json, time, re

RESULTS_DIR = ROOT / "results" / RESULTS_MODEL
DATASET_DIR = ROOT / "dataset/articles"    # reads <id>.txt (raw text — NO pre-extracted entities)

# VARIANT names the extraction ARM and is what every later stage reads: 6d canonicalizes
# nary_graph<_sfx>.json. A new prompt therefore needs a new VARIANT, or it silently overwrites the
# graphs of the arm it was meant to be compared against.
_sfx        = f"_{VARIANT}" if VARIANT else ""
OUTPUT_NAME = f"e2e/nary_graph{_sfx}.json"          # written to <RESULTS_DIR>/<id>/

# Articles this run processes: those with a raw <id>.txt. `selected_articles: null` in the config
# means the whole corpus. Numeric order (art2 before art10) — see xcfg.article_key.
_available = sorted((p.stem for p in DATASET_DIR.glob("*.txt")), key=xcfg.article_key)
if SELECTED_ARTICLES is None:
    ARTICLE_IDS = _available
else:
    missing = [a for a in SELECTED_ARTICLES if a not in _available]
    assert not missing, f"no article text for: {missing}"
    ARTICLE_IDS = list(SELECTED_ARTICLES)
ARTICLE_ID = ARTICLE_IDS[0]                # the single article the demo cell below inspects

# Articles are extracted independently — nothing is carried from one to the next — so the batch cell
# runs WORKERS of them at once. Each article costs 2 LLM calls (extract + review), so WORKERS is the
# concurrency the API sees. 1 = the plain sequential loop; use it when debugging.
print(f"\n{len(_available)} article texts available; this run processes {len(ARTICLE_IDS)}"
      f" -> results/{RESULTS_MODEL}/<id>/{OUTPUT_NAME}")
