# Incremental build. Sequential BY DESIGN: the vocabulary grows article by article and what article
# k mints depends on what k-1 added, so running the articles in parallel would change the output.
#
# FRESH comes from the config. True: start from an EMPTY vocabulary and process ALL of
# ARTICLE_ORDER — what a reported run does. False: keep the existing type_vocabulary<_osfx>.json and
# extend it with NEW_ARTICLES only (or, if that is empty, every article not yet typed).
NEW_ARTICLES = []          # used only when FRESH is False

if FRESH:
    vocab = {"types": [], "next_id": 1}; save_vocab(vocab); todo = ARTICLE_ORDER
else:
    vocab = load_vocab()
    todo  = NEW_ARTICLES or [a for a in ARTICLE_ORDER
                             if not (RESULTS_DIR / a / f"two_staged/1_entities/entities_typed{_osfx}.json").exists()]

# CONSOLIDATE_EVERY (config, 0 = off) re-consolidates every N articles instead of once at the end.
# This cell then builds only the FIRST chunk — consolidate_vocab / refresh_ext_after_consolidation are
# defined further down, so the remaining chunks are driven by the periodic cell BELOW them.
TODO_ALL = list(todo)
if CONSOLIDATE_EVERY:
    todo = TODO_ALL[:CONSOLIDATE_EVERY]

print(f"building type vocabulary over {len(todo)} article(s): {todo}\n")
nb_parallel.reset_usage()          # the report below covers only the calls THIS run makes
_t0 = time.perf_counter()

for aid in todo:
    with nb_parallel.usage_scope(aid):      # tag this article's calls so the report breaks down per article
        process_article(aid, vocab, write=True, save=True, verbose=True)
    time.sleep(5)                           # gentle on the API's per-minute limit
print(f"\ndone — {len(vocab['types'])} canonical types in {VOCAB_PATH}")

# --- what this run cost: calls, prompt / output / THINKING tokens, and elapsed time ------------
nb_parallel.usage_report(f"nb4 · type extension · {EXPERIMENT}",
                         wall_seconds=time.perf_counter() - _t0,
                         write=RESULTS_DIR / "_global" / f"token_usage_types{_osfx}.json",
                         experiment=EXPERIMENT, run_tag=RUN_TAG)
