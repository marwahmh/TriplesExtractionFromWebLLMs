# Collect + persist this stage's numbers. Pure reading — no LLM call, safe to re-run, and it works
# on a run that finished days ago.
import importlib, run_metrics
importlib.reload(run_metrics)

_m = run_metrics.types(RESULTS_DIR, ARTICLE_ORDER, isfx=_sfx, osfx=_osfx,
                       track="e2e", experiment=EXPERIMENT)
run_metrics.show(_m)

# save() also CLOSES this stage in the run manifest — the record of WHICH run these numbers
# came from: the resolved config, the git commit, the article order, every output file and
# the token spend.  results/<model>/_runs/<run_id>.json  ·  python -m run_manifest list
print("\nsaved ->", run_metrics.save(_m, RESULTS_DIR, _osfx, "e2e",
                                     section="6d", articles=ARTICLE_ORDER))

